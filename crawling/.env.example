# ────────────────────────────────────────────
# .env.example — 실제 값은 .env 파일에 작성하세요
# .env 파일은 절대 git에 커밋하지 마세요!
# ────────────────────────────────────────────

# Google AI Studio에서 발급 (https://aistudio.google.com/app/apikey)
# 사용 모델: gemini-embedding-001 (3072차원, text-embedding-004 후속)
GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone 콘솔에서 발급 (https://app.pinecone.io)
PINECONE_API_KEY=your_pinecone_api_key_here

# 저장할 Pinecone 인덱스 이름 (없으면 자동 생성)
PINECONE_INDEX_NAME=algvoca-words

# Pinecone Serverless 배포 위치 (무료 플랜 기본값)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
